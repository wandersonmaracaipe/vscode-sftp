    "set-value": "^4.0.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^5.1.4",
    "yargs-parser": "^20.2.4"
  },
  "dependencies": {
    "async": "^3.2.6",
    "basic-ftp": "^5.3.1",
