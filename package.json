{
  "name": "valuor-sftp",
  "displayName": "Valuor SFTP",
  "description": "Valuor SFTP — sincronização SFTP/FTP para o VS Code",
  "version": "1.22.2",
  "publisher": "Valuor",
  "author": "Valuor <wanderson@valuor.com.br>",
  "engines": {
    "vscode": "^1.75.0"
  },
  "bugs": {
    "url": "https://github.com/wandersonmaracaipe/vscode-sftp/issues",
    "email": "wanderson@valuor.com.br"
  },
  "homepage": "https://github.com/wandersonmaracaipe/vscode-sftp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wandersonmaracaipe/vscode-sftp.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "sftp",
    "sync",
    "remote"
  ],
  "activationEvents": [
    "workspaceContains:.vscode/sftp.json"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sftp",
          "title": "SFTP",
          "icon": "resources/sftp-view.png"
        }
      ]
    },
    "views": {
      "sftp": [
        {
          "id": "remoteExplorer",
          "name": "Explorador",
          "when": "sftp.enabled"
        },
        {
          "id": "transferHistory",
          "name": "Histórico de Transferências",
          "when": "sftp.enabled",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Configuração do sftp",
      "properties": {
        "sftp.printDebugLog": {
          "type": "boolean",
          "default": false,
          "description": "Exibe log de depuração no canal de saída do sftp. (recarregue o VS Code ao alterar isto)"
        },
        "sftp.debug": {
          "type": "boolean",
          "default": false,
          "description": "Exibe log de depuração no canal de saída do sftp. (recarregue o VS Code ao alterar isto)"
        },
        "sftp.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "\"Baixar\" em vez de \"Ver Conteúdo\" ao abrir um arquivo no Remote Explorer"
        }
      }
    },
    "commands": [
      {
        "command": "sftp.config",
        "title": "Configurar",
        "category": "SFTP"
      },
      {
        "command": "sftp.setProfile",
        "title": "Definir Perfil",
        "category": "SFTP"
      },
      {
        "command": "sftp.openConnectInTerminal",
        "title": "Abrir SSH no Terminal",
        "category": "SFTP"
      },
      {
        "command": "sftp.cancelAllTransfer",
        "title": "Cancelar Todas as Transferências",
        "category": "SFTP"
      },
      {
        "command": "sftp.migratePasswords",
        "title": "Migrar Senhas do sftp.json para o Cofre",
        "category": "SFTP"
      },
      {
        "command": "sftp.transferHistory.retry",
        "title": "Repetir Transferência",
        "category": "SFTP",
        "icon": "$(refresh)"
      },
      {
        "command": "sftp.transferHistory.retryAllFailed",
        "title": "Repetir Todas as Falhas",
        "category": "SFTP",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "sftp.transferHistory.clear",
        "title": "Limpar Histórico de Transferências",
        "category": "SFTP",
        "icon": "$(clear-all)"
      },
      {
        "command": "sftp.transferHistory.reveal",
        "title": "Abrir Arquivo do Histórico",
        "category": "SFTP"
      },
      {
        "command": "sftp.toggleUploadOnSave",
        "title": "Alternar Envio ao Salvar",
        "category": "SFTP"
      },
      {
        "command": "sftp.testConnection",
        "title": "Testar Conexão",
        "category": "SFTP"
      },
      {
        "command": "sftp.savePassword",
        "title": "Salvar Senha no Cofre",
        "category": "SFTP"
      },
      {
        "command": "sftp.clearPassword",
        "title": "Remover Senha do Cofre",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.file",
        "title": "Enviar Arquivo",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.changedFiles",
        "title": "Enviar Arquivos Alterados",
        "category": "SFTP",
        "icon": {
          "light": "resources/light/upload.svg",
          "dark": "resources/dark/upload.svg"
        }
      },
      {
        "command": "sftp.upload.activeFile",
        "title": "Enviar Arquivo Ativo",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.folder",
        "title": "Enviar Pasta",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.activeFolder",
        "title": "Enviar Pasta Ativa",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.project",
        "title": "Enviar Projeto",
        "category": "SFTP"
      },
      {
        "command": "sftp.forceUpload",
        "title": "Forçar Envio",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.file.to.allProfiles",
        "title": "Enviar Arquivo para Todos os Perfis",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.activeFile.to.allProfiles",
        "title": "Enviar Arquivo Ativo para Todos os Perfis",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.folder.to.allProfiles",
        "title": "Enviar Pasta para Todos os Perfis",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.activeFolder.to.allProfiles",
        "title": "Enviar Pasta Ativa para Todos os Perfis",
        "category": "SFTP"
      },
      {
        "command": "sftp.upload.project.to.allProfiles",
        "title": "Enviar Projeto para Todos os Perfis",
        "category": "SFTP"
      },
      {
        "command": "sftp.forceUpload.to.allProfiles",
        "title": "Forçar Envio para Todos os Perfis",
        "category": "SFTP"
      },
      {
        "command": "sftp.download.file",
        "title": "Baixar Arquivo",
        "category": "SFTP",
        "icon": {
          "dark": "resources/dark/download-file.svg",
          "light": "resources/light/download-file.svg"
        }
      },
      {
        "command": "sftp.download.activeFile",
        "title": "Baixar Arquivo Ativo",
        "category": "SFTP"
      },
      {
        "command": "sftp.download.folder",
        "title": "Baixar Pasta",
        "category": "SFTP",
        "icon": {
          "dark": "resources/dark/download-folder.svg",
          "light": "resources/light/download-folder.svg"
        }
      },
      {
        "command": "sftp.download.activeFolder",
        "title": "Baixar Pasta Ativa",
        "category": "SFTP"
      },
      {
        "command": "sftp.download.project",
        "title": "Baixar Projeto",
        "category": "SFTP"
      },
      {
        "command": "sftp.forceDownload",
        "title": "Forçar Download",
        "category": "SFTP"
      },
      {
        "command": "sftp.sync.localToRemote",
        "title": "Sincronizar Local -> Remoto",
        "category": "SFTP"
      },
      {
        "command": "sftp.sync.remoteToLocal",
        "title": "Sincronizar Remoto -> Local",
        "category": "SFTP"
      },
      {
        "command": "sftp.sync.bothDirections",
        "title": "Sincronizar nos Dois Sentidos",
        "category": "SFTP"
      },
      {
        "command": "sftp.sync.preview",
        "title": "Preview de Sincronização (Local → Remoto)",
        "category": "SFTP"
      },
      {
        "command": "sftp.sync.previewRemoteToLocal",
        "title": "Preview de Sincronização (Remoto → Local)",
        "category": "SFTP"
      },
      {
        "command": "sftp.diff",
        "title": "Comparar com o Remoto",
        "category": "SFTP"
      },
      {
        "command": "sftp.diff.activeFile",
        "title": "Comparar Arquivo Ativo com o Remoto",
        "category": "SFTP"
      },
      {
        "command": "sftp.list",
        "title": "Listar",
        "category": "SFTP"
      },
      {
        "command": "sftp.listActiveFolder",
        "title": "Listar Pasta Ativa",
        "category": "SFTP"
      },
      {
        "command": "sftp.listAll",
        "title": "Listar Tudo",
        "category": "SFTP"
      },
      {
        "command": "sftp.delete.remote",
        "title": "Excluir",
        "category": "SFTP"
      },
      {
        "command": "sftp.rename",
        "title": "Renomear / Mover",
        "category": "SFTP"
      },
      {
        "command": "sftp.create.folder",
        "title": "Criar Pasta",
        "category": "SFTP"
      },
      {
        "command": "sftp.create.file",
        "title": "Criar Arquivo",
        "category": "SFTP"
      },
      {
        "command": "sftp.revealInExplorer",
        "title": "Revelar no Explorer",
        "category": "SFTP"
      },
      {
        "command": "sftp.revealInRemoteExplorer",
        "title": "Revelar no Remote Explorer",
        "category": "SFTP"
      },
      {
        "command": "sftp.remoteExplorer.editInLocal",
        "title": "Editar Localmente",
        "category": "SFTP"
      },
      {
        "command": "sftp.viewContent",
        "title": "Ver Conteúdo",
        "category": "SFTP"
      },
      {
        "command": "sftp.remoteExplorer.refresh",
        "title": "Atualizar",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "sftp.remoteExplorer.refreshActiveFile",
        "title": "Atualizar Arquivo Remoto Ativo",
        "category": "SFTP",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sftp.transferHistory.retry",
          "when": "false"
        },
        {
          "command": "sftp.transferHistory.reveal",
          "when": "false"
        },
        {
          "command": "sftp.transferHistory.retryAllFailed",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.transferHistory.clear",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.setProfile",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.openConnectInTerminal",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.cancelAllTransfer",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.toggleUploadOnSave",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.testConnection",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.savePassword",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.clearPassword",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.activeFile",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.activeFolder",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.project",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.activeFile.to.allProfiles",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.activeFolder.to.allProfiles",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.project.to.allProfiles",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.download.activeFile",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.download.activeFolder",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.download.project",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.sync.localToRemote",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.sync.remoteToLocal",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.sync.bothDirections",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.sync.preview",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.sync.previewRemoteToLocal",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.diff.activeFile",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.list",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.listActiveFolder",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.listAll",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.file",
          "when": "false"
        },
        {
          "command": "sftp.upload.changedFiles",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.folder",
          "when": "false"
        },
        {
          "command": "sftp.forceUpload",
          "when": "false"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "when": "false"
        },
        {
          "command": "sftp.upload.folder.to.allProfiles",
          "when": "false"
        },
        {
          "command": "sftp.forceUpload.to.allProfiles",
          "when": "false"
        },
        {
          "command": "sftp.download.file",
          "when": "false"
        },
        {
          "command": "sftp.download.folder",
          "when": "false"
        },
        {
          "command": "sftp.forceDownload",
          "when": "false"
        },
        {
          "command": "sftp.diff",
          "when": "false"
        },
        {
          "command": "sftp.delete.remote",
          "when": "false"
        },
        {
          "command": "sftp.rename",
          "when": "false"
        },
        {
          "command": "sftp.create.folder",
          "when": "false"
        },
        {
          "command": "sftp.create.file",
          "when": "false"
        },
        {
          "command": "sftp.revealInExplorer",
          "when": "false"
        },
        {
          "command": "sftp.revealInRemoteExplorer",
          "when": "false"
        },
        {
          "command": "sftp.remoteExplorer.editInLocal",
          "when": "false"
        },
        {
          "command": "sftp.viewContent",
          "when": "false"
        },
        {
          "command": "sftp.remoteExplorer.refresh",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "sftp.revealInRemoteExplorer",
          "group": "navigation@20",
          "when": "sftp.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "sftp.diff",
          "group": "3_compare",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.localToRemote",
          "group": "sftp.sync@1",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.remoteToLocal",
          "group": "sftp.sync@2",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.bothDirections",
          "group": "sftp.sync@3",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.preview",
          "group": "sftp.sync@4",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.previewRemoteToLocal",
          "group": "sftp.sync@5",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.file",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.folder",
          "group": "sftp.trans@1",
          "alt": "sftp.forceUpload",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.folder.to.allProfiles",
          "group": "sftp.trans@1",
          "alt": "sftp.forceUpload.to.allProfiles",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.download.file",
          "group": "sftp.trans@2",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.download.folder",
          "group": "sftp.trans@2",
          "alt": "sftp.forceDownload",
          "when": "sftp.enabled && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "sftp.upload.file",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.download.file",
          "group": "sftp.trans@2",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.diff",
          "group": "3_compare",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "sftp.enabled && resourceScheme == remote"
        }
      ],
      "editor/title": [
        {
          "command": "sftp.remoteExplorer.refreshActiveFile",
          "group": "navigation",
          "when": "sftp.enabled && resourceScheme == remote"
        }
      ],
      "editor/title/context": [
        {
          "command": "sftp.revealInExplorer",
          "group": "2_files",
          "when": "sftp.enabled && resourceScheme == remote"
        },
        {
          "command": "sftp.revealInRemoteExplorer",
          "when": "sftp.enabled && resourceScheme == file",
          "group": "2_files"
        }
      ],
      "view/title": [
        {
          "command": "sftp.remoteExplorer.refresh",
          "when": "view == remoteExplorer",
          "group": "navigation"
        },
        {
          "command": "sftp.transferHistory.retryAllFailed",
          "when": "view == transferHistory",
          "group": "navigation@1"
        },
        {
          "command": "sftp.transferHistory.clear",
          "when": "view == transferHistory",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sftp.transferHistory.retry",
          "group": "inline",
          "when": "view == transferHistory && viewItem == failedTransfer"
        },
        {
          "command": "sftp.openConnectInTerminal",
          "group": "navigation",
          "when": "view == remoteExplorer && viewItem == root"
        },
        {
          "command": "sftp.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem == file && !config.sftp.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "sftp.viewContent",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem == file && config.sftp.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "sftp.revealInExplorer",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "sftp.upload.folder",
          "group": "3_trans@1",
          "alt": "sftp.forceUpload",
          "when": "sftp.enabled && viewItem != file"
        },
        {
          "command": "sftp.upload.file",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftp.upload.folder.to.allProfiles",
          "group": "3_trans@1",
          "alt": "sftp.forceUpload.to.allProfiles",
          "when": "sftp.enabled && viewItem != file"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftp.download.folder",
          "group": "3_trans@2",
          "alt": "sftp.forceDownload",
          "when": "sftp.enabled && viewItem != file"
        },
        {
          "command": "sftp.download.file",
          "group": "3_trans@2",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftp.delete.remote",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "sftp.rename",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "sftp.create.folder",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file"
        },
        {
          "command": "sftp.create.file",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file"
        },
        {
          "command": "sftp.download.file",
          "group": "inline",
          "when": "view == remoteExplorer && viewItem == file"
        },
        {
          "command": "sftp.download.folder",
          "group": "inline",
          "when": "sftp.enabled && view == remoteExplorer && viewItem == folder"
        }
      ],
      "scm/title": [
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && !gitFreshRepository"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "sftp.upload.changedFiles",
          "group": "inline",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "inline",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sftp.upload.changedFiles",
        "key": "ctrl+alt+u",
        "when": "sftp.enabled"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp.json",
        "url": "./schema/config.schema.json"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "remote",
        "formatting": {
          "label": "${path}",
          "separator": "/"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand --forceExit",
    "package": "vsce package",
    "pub:debug": "rm -rf _debug && mkdir _debug && vsce package --out _debug/sftp-debug.vsix && cd _debug && git init && git commit --allow-empty -m 'update debug package' && git checkout -b debug-pacakge && cp ../INSTALL_DEBUG.md README.md  && git add . && git commit -am 'update debug package' && git push git@github.com:wandersonmaracaipe/vscode-sftp.git debug-pacakge --force"
  },
